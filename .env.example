# PostgreSQL. Prisma migrations and application data use the isolated novelai_tags schema.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=verify-full"
# Optional canonical origin for production SEO. Unset follows the request Host.
# Development always follows the actual local host and port, ignoring SITE_URL.
# Reverse proxies must preserve Host and supply x-forwarded-proto (http or https).
# SITE_URL="https://your-domain.example"
# Optional override for the import source; defaults to data/loadTags.js.
# TAGS_SOURCE="/absolute/path/to/loadTags.js"
# Danbooru Tag Searcher international fallback. Server-only; never NEXT_PUBLIC_*.
# Use a key registered with Client=tag-select-astrabrew
# and Site=https://tag-select.astrabrew.cn/
DANBOORU_SEARCH_API_KEY=""
# Optional HTTP(S) proxy for official Danbooru tag examples, server-only.
# Node fetch does not automatically use the macOS system proxy.
# Leave unset on servers that can reach Danbooru directly.
# DANBOORU_IMAGE_PROXY_URL="http://127.0.0.1:7892"
