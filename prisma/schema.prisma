generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  schemas  = ["novelai_tags"]
}

model TagCategory {
  id        String     @id
  sourceKey String     @unique
  nameZh    String
  nameEn    String
  sortOrder Int
  groups    TagGroup[]
  tags      Tag[]

  @@schema("novelai_tags")
}

model TagGroup {
  id         String      @id
  categoryId String
  nameZh     String
  sortOrder  Int
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  tags       Tag[]

  @@unique([categoryId, nameZh])
  @@index([categoryId, sortOrder])
  @@schema("novelai_tags")
}

model Tag {
  id         String      @id
  categoryId String
  groupId    String
  zh         String
  en         String
  rawZh      String
  rawEn      String
  aliases    String[]    @default([])
  note       String?
  imageUrl   String?
  sortOrder  Int
  popular    Boolean     @default(false)
  category   TagCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  group      TagGroup    @relation(fields: [groupId], references: [id], onDelete: Restrict)

  @@unique([groupId, rawZh])
  @@index([categoryId, sortOrder])
  @@index([groupId, sortOrder])
  @@index([popular, sortOrder])
  @@index([en])
  @@schema("novelai_tags")
}

model CatalogImport {
  id            String   @id
  sourceFile    String
  sourceUrl     String
  sourceHash    String
  categoryCount Int
  groupCount    Int
  tagCount      Int
  imageCount    Int
  importedAt    DateTime @default(now())
  catalogGzip   Bytes?

  @@schema("novelai_tags")
}

model CodexCategory {
  id        String       @id
  title     String
  sortOrder Int
  entries   CodexEntry[]

  @@schema("novelai_tags")
}

model CodexEntry {
  id         String        @id
  categoryId String
  title      String
  anchor     String        @unique
  groups     Json
  notes      String[]      @default([])
  sortOrder  Int
  category   CodexCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([categoryId, sortOrder])
  @@schema("novelai_tags")
}

model CodexImport {
  id           String   @id
  sourceUrl    String
  sourceHash   String
  edition      String
  capturedAt   DateTime
  importedAt   DateTime @default(now())
  entryCount   Int
  omittedCount Int
  catalogGzip  Bytes

  @@schema("novelai_tags")
}

model AdultCodexVolume {
  id         String              @id
  label      String
  title      String
  url        String
  sortOrder  Int
  categories AdultCodexCategory[]
  entries    AdultCodexEntry[]

  @@schema("novelai_tags")
}

model AdultCodexCategory {
  id        String             @id
  volumeId  String
  title     String
  sortOrder Int
  volume    AdultCodexVolume   @relation(fields: [volumeId], references: [id], onDelete: Restrict)
  entries   AdultCodexEntry[]

  @@index([volumeId, sortOrder])
  @@schema("novelai_tags")
}

model AdultCodexEntry {
  id         String             @id
  volumeId   String
  categoryId String
  title      String
  anchor     String
  groups     Json
  notes      String[]           @default([])
  sortOrder  Int
  volume     AdultCodexVolume   @relation(fields: [volumeId], references: [id], onDelete: Restrict)
  category   AdultCodexCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([volumeId, sortOrder])
  @@index([categoryId, sortOrder])
  @@schema("novelai_tags")
}

model AdultCodexImport {
  id           String   @id
  sourceUrls   Json
  sourceHash   String
  capturedAt   DateTime
  importedAt   DateTime @default(now())
  volumeCount  Int
  categoryCount Int
  entryCount   Int
  groupCount   Int
  omittedCount Int
  catalogGzip  Bytes

  @@schema("novelai_tags")
}
