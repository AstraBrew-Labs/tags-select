{
  "name": "tags-select",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:import:check": "bun run scripts/seed-tags.ts --dry-run",
    "db:codex:check": "bun run scripts/import-director-codex.ts --dry-run",
    "db:codex:import": "bun run scripts/import-director-codex.ts",
    "db:setup": "bun run db:migrate && bun run db:seed",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "animal-island-ui": "^2.1.1",
    "classnames": "^2.5.1",
    "dotenv": "^18.0.6",
    "motion": "^14.0.0",
    "naive-icons": "^1.5.3",
    "next": "16.4.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "acorn": "^8.19.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "bun@1.3.14",
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@prisma/engines",
    "prisma",
    "sharp",
    "unrs-resolver"
  ]
}
